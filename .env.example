# Django Core Settings
SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Jakarta

# Database Configuration (Defaults to SQLite if DB_NAME not set)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Enterprise & ERP Integration (JDE / LDAP / SSO)
JDE_API_BASE_URL=https://jde-api.corporate.local/
JDE_API_TOKEN=
LDAP_AUTH_URL=

# Email & SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@royalcorp.co.id
EMAIL_HOST_PASSWORD=your_smtp_password_here
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Royal Workflow <notifications@royalcorp.co.id>
SERVER_EMAIL=notifications@royalcorp.co.id

# e-Meterai Single Stamping Provider (EzMeterai Sandbox)
EMATERAI_PROVIDER=mock
EMATERAI_BASE_URL=https://api-sandbox.ezmeterai.id
EMATERAI_API_KEY=your_ezmeterai_api_key_here
EMATERAI_PAGE=last
EMATERAI_POS_LLX=45.0
EMATERAI_POS_LLY=75.0
EMATERAI_POS_URX=145.0
EMATERAI_POS_URY=175.0

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id_here


